import socket

# ===================================================================
server_ip = input("Enter Server IP (e.g., 127.0.0.1): ")
server_port = int(input("Enter Server Port (e.g., 20001): "))

# ===================================================================
client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
client_socket.connect((server_ip, server_port))

# ===================================================================
assigned_ip_msg = client_socket.recv(1024).decode()
print(assigned_ip_msg.strip())

if "No IPs available" in assigned_ip_msg:
    client_socket.close()
    exit()

# ====================================================================
domain = input("Enter domain to resolve: ")
client_socket.send(domain.encode())

# ===================================================================
response = client_socket.recv(1024).decode()
print(response)

client_socket.close()
